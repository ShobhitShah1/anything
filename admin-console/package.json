{
  "name": "anything-admin-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "admin:claim": "node scripts/set-admin-claim.mjs",
    "format": "npm --prefix .. run format:admin",
    "format:check": "npm --prefix .. run format:check:shared",
    "lint": "npm --prefix .. run lint:shared"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "firebase-admin": "^13.5.0",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
