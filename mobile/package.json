  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@react-native/metro-config": "0.88.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prepare:android": "expo prebuild --platform android --no-clean --no-install",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "node --stack-size=8192 node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test src/utils/*.test.mjs",
    "export:android": "expo export --platform android",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "compress": "expo export --platform android --output-dir dist",
    "build:android:small": "npx eas-cli@latest build --platform android --profile production"
  },
  "private": true,
  "resolutions": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "enriched-markdown": {
    "enableCodeHighlight": true,
    "enableMath": false,
    "enableVideo": false
  },
  "dependenciesMeta": {
    "react-native-enriched-markdown": {
      "built": true
    }
  }
