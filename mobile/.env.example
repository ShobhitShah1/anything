EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth client of type Web application (same Google/Firebase project).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Required only for iOS login; use the iOS OAuth client ID.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID, used by the config plugin at build time.
GOOGLE_IOS_URL_SCHEME=

# Cloudflare Worker URL, ending in /ai (no private AI keys in the app).
EXPO_PUBLIC_AI_URL=
# Optional Test Store public key, used ONLY in debug/development builds.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
# RevenueCat public SDK keys (one app per platform, mandatory in release builds).
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Optional overrides for membership policy links (defaults use the product website).
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
