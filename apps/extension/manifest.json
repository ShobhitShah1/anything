{
  "manifest_version": 3,
  "name": "Save to Anything",
  "version": "1.4.1",
  "description": "Save pages, links, images and selected text to your own Anything collection.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://shobhitshah1.github.io/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "optional_permissions": ["clipboardRead"],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon32.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Save to Anything"
  }
}
