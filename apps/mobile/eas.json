{
  "build": {
    "development": {
      "corepack": true,
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "credentialsSource": "local"
      },
      "environment": "development"
    },
    "preview": {
      "corepack": true,
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "environment": "preview"
    },
    "preview-arm64": {
      "extends": "preview"
    },
    "production": {
      "corepack": true,
      "channel": "production",
      "android": {
        "credentialsSource": "local",
        "buildType": "app-bundle"
      },
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true
    },
    "store-test": {
      "extends": "production",
      "channel": "store-test",
      "environment": "preview"
    }
  },
  "cli": {
    "appVersionSource": "remote"
  },
  "submit": {
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
